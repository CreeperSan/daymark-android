const TABLES: Map<Lang, Map<string, string>> = new Map<Lang, Map<string, string>>([
  ['zh-Hans', ZH_HANS],
  ['zh-Hant', ZH_HANT],
  ['en', EN]
]);

export class I18n {
  private static current: Lang = 'zh-Hans';

  static setLanguage(lang: Lang): void {
    I18n.current = lang;
  }

  static language(): Lang {
    return I18n.current;
  }

  /** 取文案；缺失时回退简体中文，再不济返回键名，避免界面出现空白。 */
  static t(key: string, arg0: string = '', arg1: string = ''): string {
    let value = TABLES.get(I18n.current)?.get(key);
    if (value === undefined) {
      value = ZH_HANS.get(key);
    }
    if (value === undefined) {
      return key;
    }
    return value.replace('{0}', arg0).replace('{1}', arg1);
  }

  /** 是否为中文环境，农历名称在中文下使用“正月初一”这类写法。 */
  static isChinese(): boolean {
    return I18n.current !== 'en';
  }

  static weekdayShort(index: number): string {
    if (I18n.current === 'en') {
      const names: string[] = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
      return names[index];
    }
    const names: string[] = ['周日', '周一', '周二', '周三', '周四', '周五', '周六'];
    return names[index];
  }
}
