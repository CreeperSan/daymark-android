<?xml version="1.0" encoding="utf-8"?>
<resources>


    <!-- 下面是当前应用的主题先关属性 -->
    <declare-styleable name="MDTheme">
        <attr name="md_color_bg_page" format="color|reference"/>
        <attr name="md_color_bg_card" format="color|reference"/>

        <attr name="md_color_primary" format="color|reference"/>
        <attr name="md_color_primary_darken" format="color|reference"/>
        <attr name="md_color_primary_lighten" format="color|reference"/>
        <attr name="md_color_accent" format="color|reference"/>

        <attr name="md_color_text_primary" format="color|reference"/>
        <attr name="md_color_text_secondary" format="color|reference"/>
        <attr name="md_color_text_hint" format="color|reference"/>
        <attr name="md_color_text_week" format="color|reference"/>
        <attr name="md_color_text_notice" format="color|reference"/>
        <attr name="md_color_text_warming" format="color|reference"/>

        <!-- 控件相关 -->
        <attr name="md_text_field_color_bg" format="color|reference"/>
        <attr name="md_text_field_color_stroke" format="color|reference"/>
    </declare-styleable>


    <declare-styleable name="CalendarDayView">
        <attr name="cdv_day_text" format="string|reference"/>
        <attr name="cdv_day_text_size" format="dimension|reference"/>
        <attr name="cdv_day_text_color" format="color|reference"/>
        <attr name="cdv_description_text" format="string|reference"/>
        <attr name="cdv_description_text_size" format="dimension|reference"/>
        <attr name="cdv_description_text_color" format="color|reference"/>
        <attr name="cdv_hint_color" format="color|reference"/>
        <attr name="cdv_hint_visible" format="boolean|reference"/>
    </declare-styleable>

</resources>