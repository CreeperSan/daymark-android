<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET"/>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher_02"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.MemorialDay"
        android:name=".application.MemorialDayApplication"
        tools:targetApi="31"
        tools:ignore="LockedOrientationActivity">

        <activity
            android:name=".activity.main.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MemorialDay"/>

        <activity
            android:name=".activity.business.CSBusinessActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MemorialDay" />

        <activity
            android:name=".activity.add.AddEditMemorialDayActivity"
            android:screenOrientation="portrait"/>

        <activity
            android:name=".activity.intro.IntroActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <activity android:name=".activity.login.LoginActivity" />

        <activity android:name=".activity.register.RegisterActivity" />

        <activity android:name=".activity.forget_password.ForgetPasswordActivity" />

        <activity android:name=".module.route.navigator.CSEmailVerificationActivity" />

        <activity
            android:name=".module.route.navigator.CSNavigationResultActivity"
            android:exported="false"
            android:theme="@style/Theme.MemorialDay" />

        <activity android:name=".activity.index.IndexActivity" />

        <activity
            android:name=".widget.composable.CSComponentShowcaseActivity"
            android:exported="false" />

    </application>

</manifest>