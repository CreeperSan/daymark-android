<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 默认主题（樟木 CamphorWood） -->
    <style name="Theme.MemorialDay" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="md_color_bg_page">@color/theme_camphor_wood_color_background</item>
        <item name="md_color_bg_card">@color/white</item>

        <item name="md_color_primary">@color/theme_camphor_wood_color_primary</item>
        <item name="md_color_primary_lighten">@color/theme_camphor_wood_color_primary</item>
        <item name="md_color_primary_darken">@color/theme_camphor_wood_color_primary</item>
        <item name="md_color_accent">@color/theme_camphor_wood_color_accent</item>

        <item name="md_color_text_primary">@color/theme_camphor_wood_color_text_primary</item>
        <item name="md_color_text_secondary">@color/theme_camphor_wood_color_text_secondary</item>
        <item name="md_color_text_hint">@color/theme_camphor_wood_color_text_hint</item>
        <item name="md_color_text_week">@color/theme_camphor_wood_color_text_week</item>
        <item name="md_color_text_notice">#FF7400</item>
        <item name="md_color_text_warming">#FF0000</item>

        <item name="md_text_field_color_bg">#f6f6f6</item>
        <item name="md_text_field_color_stroke">#e3e3e3</item>

        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/theme_camphor_wood_color_background</item>
        <item name="android:navigationBarColor">@color/theme_camphor_wood_color_background</item>
    </style>

    <style name="Theme.MemorialDayCompose" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- 系统启动窗口主题；启动 Activity 调用 installSplashScreen() 后自动切换到默认主题。 -->
    <style name="Theme.MemorialDay.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/theme_camphor_wood_color_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_02</item>
        <item name="postSplashScreenTheme">@style/Theme.MemorialDay</item>
    </style>


    <style name="MemorialDayDialog" parent="android:Theme.Dialog">
        <item name="android:windowFrame">@null</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>

</resources>