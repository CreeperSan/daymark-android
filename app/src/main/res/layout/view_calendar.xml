<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">


    <ImageView
        android:id="@+id/leftArrow"
        android:layout_width="52dp"
        android:layout_height="68dp"
        android:contentDescription="@null"
        android:padding="10dp"
        android:src="@drawable/ic_arrow_left_black_24"
        app:layout_constraintStart_toStartOf="@id/calendarMonthView"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/yearText"
        app:layout_constraintBottom_toTopOf="@id/lunarText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/monthText"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintVertical_bias="0.5"
        app:layout_constraintStart_toEndOf="@id/leftArrow"
        app:layout_constraintTop_toTopOf="@id/leftArrow"
        tools:text="2023年" />

    <TextView
        android:id="@+id/monthText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/yearText"
        app:layout_constraintEnd_toStartOf="@id/rightArrow"
        app:layout_constraintStart_toEndOf="@id/yearText"
        app:layout_constraintTop_toTopOf="@id/yearText"
        tools:text="12月" />

    <TextView
        app:layout_constraintStart_toEndOf="@id/leftArrow"
        app:layout_constraintEnd_toStartOf="@id/rightArrow"
        android:textAlignment="center"
        app:layout_constraintTop_toBottomOf="@id/yearText"
        app:layout_constraintBottom_toBottomOf="@id/leftArrow"
        android:text="xx年xx月"
        android:textSize="11sp"
        android:id="@+id/lunarText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"/>

    <ImageView
        android:id="@+id/rightArrow"
        android:layout_width="52dp"
        android:layout_height="0dp"
        android:contentDescription="@null"
        android:padding="10dp"
        android:src="@drawable/ic_arrow_right_black_24"
        app:layout_constraintEnd_toEndOf="@id/calendarMonthView"
        app:layout_constraintTop_toTopOf="@id/leftArrow"
        app:layout_constraintBottom_toBottomOf="@id/leftArrow"/>

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="leftArrow,yearText,monthText,rightArrow" />

    <com.creepersan.memorialday.ui.widget.calendar_view.CalendarMonthView
        app:layout_constraintTop_toBottomOf="@id/barrier"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:id="@+id/calendarMonthView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <ProgressBar
        android:id="@+id/progressBar"
        app:layout_constraintStart_toStartOf="@id/calendarMonthView"
        app:layout_constraintEnd_toEndOf="@id/calendarMonthView"
        app:layout_constraintBottom_toBottomOf="@id/calendarMonthView"
        app:layout_constraintTop_toTopOf="@id/calendarMonthView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>


</androidx.constraintlayout.widget.ConstraintLayout>