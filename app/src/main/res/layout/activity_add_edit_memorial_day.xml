<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:background="?attr/md_color_bg_page"
    android:layout_height="match_parent">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="36dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:layout_marginTop="52dp"
            android:id="@+id/pageTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:text="添加纪念日"
            android:textColor="?attr/md_color_text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:text="名称"
            android:drawableStart="@drawable/indicator_add_edit_memorial_day"
            android:drawablePadding="8dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="72dp"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="?attr/md_color_text_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <EditText
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:hint="请输入纪念日名称"
            android:textSize="18sp" />


        <TextView
            android:text="时间"
            android:drawableStart="@drawable/indicator_add_edit_memorial_day"
            android:drawablePadding="8dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="?attr/md_color_text_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="0dp"
            android:editable="false"
            android:layout_marginEnd="16dp"
            android:hint="点击设置时间"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textSize="18sp" />


        <TextView
            android:text="倒计时循环"
            android:drawableStart="@drawable/indicator_add_edit_memorial_day"
            android:drawablePadding="8dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="?attr/md_color_text_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <RadioGroup
            android:orientation="horizontal"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:id="@+id/loopGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/loopYearly"
                android:text="每年"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <RadioButton
                android:id="@+id/loopOnce"
                android:text="单次"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

        </RadioGroup>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="52dp"
            android:layout_marginEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="12dp"
            android:background="?attr/md_color_primary"
            android:text="保存"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/delete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:paddingTop="8dp"
            android:textAlignment="center"
            android:paddingBottom="12dp"
            android:textColor="?attr/md_color_text_warming"
            android:text="删除"
            android:textSize="18sp" />

    </androidx.appcompat.widget.LinearLayoutCompat>

</ScrollView>